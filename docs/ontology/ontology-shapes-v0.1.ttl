@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ex: <urn:kacp:mock:> .

ex:WarehouseShape a sh:NodeShape ;
    sh:targetClass ex:Warehouse ;
    sh:property [ sh:path ex:id ; sh:minCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path ex:name ; sh:minCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path ex:level ; sh:datatype xsd:integer ; sh:in ( 1 2 3 4 ) ] ;
    sh:property [ sh:path ex:longitude ; sh:datatype xsd:decimal ] ;
    sh:property [ sh:path ex:latitude ; sh:datatype xsd:decimal ] ;
    sh:property [ sh:path ex:locatedIn ; sh:node ex:RegionShape ; sh:maxCount 1 ] .

ex:StockRecordShape a sh:NodeShape ;
    sh:targetClass ex:StockRecord ;
    sh:property [ sh:path ex:id ; sh:minCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path ex:warehouse ; sh:minCount 1 ; sh:maxCount 1 ; sh:class ex:Warehouse ] ;
    sh:property [ sh:path ex:refersToMaterial ; sh:minCount 1 ; sh:maxCount 1 ; sh:class ex:Material ] ;
    sh:property [ sh:path ex:quantity ; sh:minCount 1 ; sh:datatype xsd:decimal ; sh:minInclusive 0 ] ;
    sh:property [ sh:path ex:unitPrice ; sh:datatype xsd:decimal ; sh:minInclusive 0 ] ;
    sh:property [ sh:path ex:totalPrice ; sh:datatype xsd:decimal ; sh:minInclusive 0 ] ;
    sh:property [ sh:path ex:usageType ; sh:in ( "项目物资" "储备物资" "闲置物资" "报废物资" "战略储备物资" "常规储备物资" ) ] ;
    sh:property [ sh:path ex:inventoryAge ; sh:in ( "1年以内" "1-3年" "3-5年" "5-10年" "10年以上" ) ] .

ex:MaterialShape a sh:NodeShape ;
    sh:targetClass ex:Material ;
    sh:property [ sh:path ex:id ; sh:minCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path ex:name ; sh:minCount 1 ; sh:datatype xsd:string ] .

ex:SupplierShape a sh:NodeShape ;
    sh:targetClass ex:Supplier ;
    sh:property [ sh:path ex:id ; sh:minCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path ex:name ; sh:datatype xsd:string ] .

ex:ProjectShape a sh:NodeShape ;
    sh:targetClass ex:Project ;
    sh:property [ sh:path ex:id ; sh:minCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path ex:name ; sh:datatype xsd:string ] .

ex:RegionShape a sh:NodeShape ;
    sh:targetClass ex:Region ;
    sh:property [ sh:path ex:provinceCode ; sh:minCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path ex:bureauCode ; sh:datatype xsd:string ] .

ex:InventorySummaryShape a sh:NodeShape ;
    sh:targetClass ex:InventorySummary ;
    sh:property [ sh:path ex:id ; sh:minCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path ex:amount ; sh:minCount 1 ; sh:datatype xsd:decimal ; sh:minInclusive 0 ] ;
    sh:property [ sh:path ex:warehouseLevel ; sh:datatype xsd:integer ; sh:in ( 1 2 3 4 ) ] .
