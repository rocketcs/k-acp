{
  "版本": "0.1.0-cn",
  "命名空间": "urn:kacp:mock:",
  "说明": "DM8 MOCK_APP 电力物资数据的中文本体映射；业务编码保留为稳定标识，类、关系、属性和枚举值使用中文。",
  "数据源": {
    "数据库容器": "dm8-mock",
    "模式": "MOCK_APP",
    "读取方式": "只读抽取"
  },
  "类": {
    "仓库": "urn:kacp:mock:warehouse:{仓库编号}",
    "库存记录": "urn:kacp:mock:stock:{库存分配编号}",
    "物资": "urn:kacp:mock:material:{物资编号}",
    "供应商": "urn:kacp:mock:supplier:{供应商编号}",
    "项目": "urn:kacp:mock:project:{项目编号}",
    "区域": "urn:kacp:mock:region:{省份编码}:{地市局编码}"
  },
  "关系": {
    "包含库存": {"主体": "仓库", "客体": "库存记录", "来源字段": "actual_warehouse_id"},
    "对应仓库": {"主体": "库存记录", "客体": "仓库", "来源字段": "actual_warehouse_id"},
    "对应物资": {"主体": "库存记录", "客体": "物资", "来源字段": "material_id"},
    "由供应商提供": {"主体": "库存记录", "客体": "供应商", "来源字段": "vendor_id"},
    "归属项目": {"主体": "库存记录", "客体": "项目", "来源字段": "project_id", "可为空": true},
    "位于区域": {"主体": "仓库", "客体": "区域", "来源字段": ["province_code", "bureau_code"]}
  },
  "属性": {
    "数量": "actual_qty",
    "单价": "unit_price",
    "金额": "actual_total_price",
    "用途": "usage_name（由用途编码转换）",
    "库龄": "inventory_age_name（由库龄编码转换）",
    "仓库等级": "warehouse_level_name（由仓库等级编码转换）",
    "仓库等级编码": "warehouse_level",
    "省份编码": "province_code",
    "地市局编码": "bureau_code",
    "标识": "业务主键生成的稳定标识"
  },
  "枚举": {
    "用途": {
      "U1": "项目物资",
      "U2": "储备物资",
      "U3": "闲置物资",
      "U4": "报废物资",
      "U5": "战略储备物资",
      "U6": "常规储备物资"
    },
    "库龄": {
      "-1": null,
      "1": "1年以内",
      "3": "3-5年",
      "5": "5-10年",
      "10": "10年以上"
    },
    "仓库等级": {
      "1": "区域仓",
      "2": "周转仓",
      "3": "急救包",
      "4": "施工现场"
    }
  },
  "中文三元组约定": "仓库:WH0000527 —包含库存→ 库存记录:INV000000000；库存记录:INV000000000 —对应物资→ 物资:MAT000001"
}
