        <mxCell id="edgeAmbClarify" value="否 / 需确认" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#EA580C;strokeWidth=2;endArrow=block;endFill=1;fontColor=#C2410C;fontSize=12;" edge="1" parent="1" source="ambiguity" target="clarify"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="edgeClarifyReturn" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#EA580C;strokeWidth=2;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="clarify" target="clarifyReturn"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="edgeReturnInput" value="用户选择/补填" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#EA580C;strokeWidth=2;endArrow=block;endFill=1;dashed=1;fontColor=#C2410C;fontSize=12;" edge="1" parent="1" source="clarifyReturn" target="input"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="85" y="580"/><mxPoint x="85" y="260"/></Array></mxGeometry></mxCell>
        <mxCell id="edgeAmbOut" value="是 / resolved" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#059669;strokeWidth=2;endArrow=block;endFill=1;fontColor=#047857;fontSize=12;" edge="1" parent="1" source="ambiguity" target="semanticOut"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="edgeOutContext" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4F46E5;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1" source="semanticOut" target="context"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="edgeContextMdl" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4F46E5;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="context" target="mdl"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="edgeMdlPreflight" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4F46E5;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="mdl" target="preflight"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="edgePreflightAllowed" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4F46E5;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="preflight" target="allowed"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="edgeAllowedPlan" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#059669;strokeWidth=2;endArrow=block;endFill=1;fontColor=#047857;fontSize=12;" edge="1" parent="1" source="allowed" target="planOut"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="edgeBlockedClarify" value="否 / blocked：修正或澄清" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#EA580C;strokeWidth=2;endArrow=block;endFill=1;dashed=1;fontColor=#C2410C;fontSize=12;" edge="1" parent="1" source="allowed" target="clarify"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="970" y="700"/><mxPoint x="640" y="700"/></Array></mxGeometry></mxCell>
        <mxCell id="edgePlanQuery" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#7C3AED;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1" source="planOut" target="query"><mxGeometry relative="1" as="geometry"/></mxCell>
