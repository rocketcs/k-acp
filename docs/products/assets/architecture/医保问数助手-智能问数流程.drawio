        <mxCell id="edgeExplainerOut" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#16A34A;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="explainer" target="answerOut"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="outputs" value="每阶段关键产出 / Auditable Outputs" style="swimlane;html=1;rounded=1;startSize=35;horizontal=1;fillColor=#FFFFFF;swimlaneFillColor=#F1F5F9;strokeColor=#94A3B8;fontColor=#334155;fontStyle=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="30" y="850" width="2110" height="205" as="geometry"/></mxCell>
        <mxCell id="o1" value="&lt;b&gt;01 原始问题&lt;/b&gt;&lt;br&gt;问题 + 会话上下文" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#93C5FD;fontSize=13;fontColor=#1E40AF;" vertex="1" parent="outputs"><mxGeometry x="25" y="70" width="300" height="85" as="geometry"/></mxCell>
        <mxCell id="o2" value="&lt;b&gt;02 语义解析&lt;/b&gt;&lt;br&gt;意图 · 目录域 · 字段 · 参数&lt;br&gt;或 needs_clarification" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDFA;strokeColor=#5EEAD4;fontSize=13;fontColor=#115E59;" vertex="1" parent="outputs"><mxGeometry x="390" y="70" width="330" height="85" as="geometry"/></mxCell>
        <mxCell id="o3" value="&lt;b&gt;03 语义依据与查询计划&lt;/b&gt;&lt;br&gt;模型/字段/规则/provenance · trace_id · 经预检 SQL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#A5B4FC;fontSize=13;fontColor=#3730A3;" vertex="1" parent="outputs"><mxGeometry x="785" y="70" width="405" height="85" as="geometry"/></mxCell>
        <mxCell id="o4" value="&lt;b&gt;04 真实查询与证据&lt;/b&gt;&lt;br&gt;PostgreSQL rows · truncated&lt;br&gt;可选 Neo4j 来源子图" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#C4B5FD;fontSize=13;fontColor=#5B21B6;" vertex="1" parent="outputs"><mxGeometry x="1255" y="70" width="355" height="85" as="geometry"/></mxCell>
        <mxCell id="o5" value="&lt;b&gt;05 最终业务答案&lt;/b&gt;&lt;br&gt;结论 · 完整表格/详情 · 口径 · 来源 · 下钻/追问" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#86EFAC;fontSize=13;fontColor=#166534;" vertex="1" parent="outputs"><mxGeometry x="1675" y="70" width="390" height="85" as="geometry"/></mxCell>
        <mxCell id="footnote" value="约束：业务事实仅来自 query 的 PostgreSQL 结果；Neo4j 仅提供本轮结果的来源、映射和审核追溯。预检 blocked 不执行查询；warning 需披露影响后方可只读查询。" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#64748B;" vertex="1" parent="1"><mxGeometry x="190" y="1080" width="1780" height="28" as="geometry"/></mxCell>
