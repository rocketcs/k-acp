<mxfile host="app.diagrams.net" modified="2026-08-25T00:00:00.000Z" agent="Codex" version="26.0.14" type="device">
  <diagram id="medical-query-pipeline" name="医保智能问数流程">
    <mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="医保问数助手 · 智能问数流程 / Medical Intelligent Query Pipeline" style="text;html=1;align=center;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#1D4ED8;" vertex="1" parent="1"><mxGeometry x="250" y="10" width="1500" height="35" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="自然语言问题 → 受控语义查询 → 真实数据与可追溯证据 → 可解释答案" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="250" y="44" width="1500" height="24" as="geometry"/></mxCell>

        <mxCell id="laneInput" value="1  用户与会话输入\nUser &amp; Session" style="swimlane;html=1;rounded=1;startSize=42;horizontal=1;fillColor=#F8FBFF;swimlaneFillColor=#DBEAFE;strokeColor=#60A5FA;fontColor=#1D4ED8;fontStyle=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="30" y="95" width="255" height="715" as="geometry"/></mxCell>
        <mxCell id="input" value="&lt;b&gt;业务人员提问&lt;/b&gt;&lt;br&gt;自然语言 · 快捷问题&lt;br&gt;连续追问 · 上下文/文件" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#93C5FD;fontSize=15;fontColor=#1E3A8A;shadow=1;" vertex="1" parent="laneInput"><mxGeometry x="25" y="85" width="205" height="115" as="geometry"/></mxCell>
        <mxCell id="session" value="会话上下文&lt;br&gt;历史问法 · 已选口径&lt;br&gt;用户权限/可见范围" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#93C5FD;fontSize=13;fontColor=#1E40AF;" vertex="1" parent="laneInput"><mxGeometry x="25" y="245" width="205" height="94" as="geometry"/></mxCell>
        <mxCell id="clarifyReturn" value="澄清结果回填&lt;br&gt;点选/补填后续跑" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#FB923C;fontSize=13;fontColor=#9A3412;" vertex="1" parent="laneInput"><mxGeometry x="25" y="510" width="205" height="72" as="geometry"/></mxCell>
        <mxCell id="inputOut" value="输入：问题 + 会话上下文" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#93C5FD;fontSize=13;fontColor=#1E40AF;" vertex="1" parent="laneInput"><mxGeometry x="25" y="630" width="205" height="48" as="geometry"/></mxCell>

        <mxCell id="laneSemantic" value="2  语义理解与澄清\nSemantic Understanding" style="swimlane;html=1;rounded=1;startSize=42;horizontal=1;fillColor=#F7FFFC;swimlaneFillColor=#CCFBF1;strokeColor=#2DD4BF;fontColor=#0F766E;fontStyle=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="325" y="95" width="405" height="715" as="geometry"/></mxCell>
        <mxCell id="skill" value="&lt;b&gt;医保目录语义技能&lt;/b&gt;&lt;br&gt;medical-catalog-question-semantics" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5EEAD4;fontSize=15;fontColor=#115E59;shadow=1;" vertex="1" parent="laneSemantic"><mxGeometry x="35" y="65" width="335" height="68" as="geometry"/></mxCell>
        <mxCell id="parse" value="&lt;b&gt;解析问题&lt;/b&gt;&lt;br&gt;意图识别 · 目录域判定&lt;br&gt;实体/字段映射 · 参数抽取&lt;br&gt;药品 / 耗材 / 服务 / 诊疗" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDFA;strokeColor=#5EEAD4;fontSize=14;fontColor=#115E59;" vertex="1" parent="laneSemantic"><mxGeometry x="35" y="160" width="335" height="120" as="geometry"/></mxCell>
        <mxCell id="ambiguity" value="关键语义是否明确？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;fontSize=14;fontStyle=1;fontColor=#92400E;" vertex="1" parent="laneSemantic"><mxGeometry x="120" y="315" width="165" height="85" as="geometry"/></mxCell>
        <mxCell id="clarify" value="&lt;b&gt;needs_clarification&lt;/b&gt;&lt;br&gt;UIP choice / form / confirm&lt;br&gt;聚焦 1–3 个关键歧义&lt;br&gt;&lt;font color=&quot;#B45309&quot;&gt;交互闭环待持续验证&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#FB923C;fontSize=13;fontColor=#9A3412;" vertex="1" parent="laneSemantic"><mxGeometry x="35" y="445" width="335" height="110" as="geometry"/></mxCell>
        <mxCell id="semanticOut" value="输出：resolved 解析结果&lt;br&gt;intent · catalog_domain · params&lt;br&gt;published/evidence columns · constraints" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#34D399;fontSize=13;fontColor=#065F46;" vertex="1" parent="laneSemantic"><mxGeometry x="35" y="615" width="335" height="70" as="geometry"/></mxCell>

        <mxCell id="lanePlan" value="3  语义上下文与查询规划\nContext &amp; Query Planning" style="swimlane;html=1;rounded=1;startSize=42;horizontal=1;fillColor=#F8FAFF;swimlaneFillColor=#E0E7FF;strokeColor=#818CF8;fontColor=#4338CA;fontStyle=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="770" y="95" width="420" height="715" as="geometry"/></mxCell>
        <mxCell id="context" value="&lt;b&gt;semantic_context(dataset_id, question)&lt;/b&gt;&lt;br&gt;返回：命中模型、推荐字段、规则、provenance、graph_version、&lt;b&gt;trace_id&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A5B4FC;fontSize=13;fontColor=#3730A3;shadow=1;" vertex="1" parent="lanePlan"><mxGeometry x="35" y="70" width="350" height="94" as="geometry"/></mxCell>
        <mxCell id="mdl" value="&lt;b&gt;构造受控 MDL SQL&lt;/b&gt;&lt;br&gt;模型：medical_catalog&lt;br&gt;按目录域选择白名单字段&lt;br&gt;过滤 · 聚合 · 排序 · 证据列" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#A5B4FC;fontSize=14;fontColor=#3730A3;" vertex="1" parent="lanePlan"><mxGeometry x="35" y="205" width="350" height="112" as="geometry"/></mxCell>
        <mxCell id="preflight" value="&lt;b&gt;query_preflight&lt;/b&gt;&lt;br&gt;dataset_id + question + SQL + trace_id&lt;br&gt;校验字段、口径、只读约束与风险" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#818CF8;fontSize=14;fontColor=#3730A3;" vertex="1" parent="lanePlan"><mxGeometry x="35" y="365" width="350" height="90" as="geometry"/></mxCell>
        <mxCell id="allowed" value="allowed / warning？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;fontSize=14;fontStyle=1;fontColor=#92400E;" vertex="1" parent="lanePlan"><mxGeometry x="125" y="505" width="170" height="82" as="geometry"/></mxCell>
        <mxCell id="planOut" value="输出：经预检允许的 MDL SQL + trace_id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#34D399;fontSize=13;fontColor=#065F46;" vertex="1" parent="lanePlan"><mxGeometry x="35" y="625" width="350" height="55" as="geometry"/></mxCell>

        <mxCell id="laneData" value="4  受控执行与证据追溯\nTrusted Execution &amp; Evidence" style="swimlane;html=1;rounded=1;startSize=42;horizontal=1;fillColor=#FCFAFF;swimlaneFillColor=#EDE9FE;strokeColor=#A78BFA;fontColor=#6D28D9;fontStyle=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1230" y="95" width="420" height="715" as="geometry"/></mxCell>
        <mxCell id="query" value="&lt;b&gt;query(dataset_id, sql, limit, trace_id)&lt;/b&gt;&lt;br&gt;唯一业务事实查询入口&lt;br&gt;返回 columns / rows / truncated" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C4B5FD;fontSize=13;fontColor=#5B21B6;shadow=1;" vertex="1" parent="laneData"><mxGeometry x="35" y="70" width="350" height="85" as="geometry"/></mxCell>
        <mxCell id="postgres" value="&lt;b&gt;Wren MDL 语义层&lt;/b&gt; → PostgreSQL&lt;br&gt;medical_catalog 及物理视图&lt;br&gt;&lt;font color=&quot;#7C3AED&quot;&gt;真实数据来源：只读查询结果&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#C4B5FD;fontSize=13;fontColor=#5B21B6;" vertex="1" parent="laneData"><mxGeometry x="35" y="195" width="350" height="88" as="geometry"/></mxCell>
        <mxCell id="hasRows" value="是否返回记录？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;fontSize=14;fontStyle=1;fontColor=#92400E;" vertex="1" parent="laneData"><mxGeometry x="125" y="325" width="170" height="82" as="geometry"/></mxCell>
        <mxCell id="evidence" value="&lt;b&gt;evidence_subgraph(dataset_id, trace_id)&lt;/b&gt;&lt;br&gt;仅从本轮 Wren 结果提取有界标识&lt;br&gt;固定参数化、只读 Cypher 投影" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#A78BFA;fontSize=13;fontColor=#5B21B6;" vertex="1" parent="laneData"><mxGeometry x="35" y="455" width="350" height="90" as="geometry"/></mxCell>
        <mxCell id="neo4j" value="&lt;b&gt;Neo4j 证据子图（可选）&lt;/b&gt;&lt;br&gt;目录项 → 原始记录 → 来源文件 → 导入批次&lt;br&gt;仅做来源/映射/审核追溯，不补写业务事实" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#A78BFA;fontSize=13;fontColor=#5B21B6;" vertex="1" parent="laneData"><mxGeometry x="35" y="590" width="350" height="92" as="geometry"/></mxCell>

        <mxCell id="laneAnswer" value="5  答案与可解释呈现\nAnswer &amp; Presentation" style="swimlane;html=1;rounded=1;startSize=42;horizontal=1;fillColor=#F7FFFA;swimlaneFillColor=#DCFCE7;strokeColor=#4ADE80;fontColor=#15803D;fontStyle=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1690" y="95" width="450" height="715" as="geometry"/></mxCell>
        <mxCell id="answer" value="&lt;b&gt;大模型 / 问数智能体生成答案&lt;/b&gt;&lt;br&gt;基于真实 query 结果，禁止以图谱节点代替事实" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#86EFAC;fontSize=14;fontColor=#166534;shadow=1;" vertex="1" parent="laneAnswer"><mxGeometry x="35" y="70" width="380" height="76" as="geometry"/></mxCell>
        <mxCell id="render" value="&lt;b&gt;MarkdownRenderer 呈现&lt;/b&gt;&lt;br&gt;列表：完整 Markdown 表格&lt;br&gt;详情：逐字段展示&lt;br&gt;结论 · 截断说明 · 口径/来源引用" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#86EFAC;fontSize=14;fontColor=#166534;" vertex="1" parent="laneAnswer"><mxGeometry x="35" y="190" width="380" height="112" as="geometry"/></mxCell>
        <mxCell id="explainer" value="可展开的解释能力&lt;br&gt;MDL 结构（命中模型/字段/provenance）&lt;br&gt;执行链路（trace_id）&lt;br&gt;数据管理图谱（仅 evidence 非空时）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#4ADE80;fontSize=13;fontColor=#166534;" vertex="1" parent="laneAnswer"><mxGeometry x="35" y="360" width="380" height="108" as="geometry"/></mxCell>
        <mxCell id="answerOut" value="最终输出：可信业务答案 · 明细数据 · 口径与来源 · 追问建议" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#34D399;fontSize=14;fontStyle=1;fontColor=#065F46;" vertex="1" parent="laneAnswer"><mxGeometry x="35" y="610" width="380" height="70" as="geometry"/></mxCell>

