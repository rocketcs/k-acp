        <mxCell id="edgeDbRows" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#7C3AED;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="postgres" target="hasRows"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="edgeRowsEvidence" value="有记录" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#7C3AED;strokeWidth=2;endArrow=block;endFill=1;fontColor=#6D28D9;fontSize=12;" edge="1" parent="1" source="hasRows" target="evidence"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="edgeEvidenceNeo4j" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#7C3AED;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="evidence" target="neo4j"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="edgeRowsAnswer" value="0 行：仅空结果说明" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#64748B;strokeWidth=2;endArrow=block;endFill=1;dashed=1;fontColor=#475569;fontSize=12;" edge="1" parent="1" source="hasRows" target="answer"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1600" y="390"/><mxPoint x="1740" y="390"/></Array></mxGeometry></mxCell>
        <mxCell id="edgeNeoAnswer" value="证据非空则附图谱入口" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#16A34A;strokeWidth=3;endArrow=block;endFill=1;fontColor=#15803D;fontSize=12;" edge="1" parent="1" source="neo4j" target="answer"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1710" y="735"/><mxPoint x="1710" y="205"/></Array></mxGeometry></mxCell>
        <mxCell id="edgeAnswerRender" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#16A34A;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="answer" target="render"><mxGeometry relative="1" as="geometry"/></mxCell>
