# Operator-local configuration. Copy this file to .env and replace every
# CHANGEME value. This file is intentionally safe to commit.
KACP_ENV=test

SSH_HOST=CHANGEME_TEST_SSH_HOST
SSH_PORT=22
SSH_USER=CHANGEME_TEST_SSH_USER
# Set exactly one authentication method. Keep SSH_IDENTITY_FILE empty when
# using password authentication.
SSH_IDENTITY_FILE=
SSH_PASSWORD=CHANGEME_TEST_SSH_PASSWORD
SSH_KNOWN_HOSTS_FILE=/absolute/path/to/test_known_hosts

MYSQL_HOST=CHANGEME_TEST_MYSQL_HOST
MYSQL_PORT=3306
MYSQL_DATABASE=apboa_next
MYSQL_USER=CHANGEME_TEST_MYSQL_USER
MYSQL_PASSWORD=CHANGEME_TEST_MYSQL_PASSWORD
MYSQL_SSL_MODE=VERIFY_CA
MYSQL_SSL_CA=/absolute/path/to/test_mysql_ca.pem
