# Operator-local configuration. Copy this file to .env and replace every
# CHANGEME value. This file is intentionally safe to commit.
KACP_ENV=local

# Local SSH is optional and disabled by default.
SSH_HOST=
SSH_PORT=22
SSH_USER=
SSH_IDENTITY_FILE=
SSH_PASSWORD=
SSH_KNOWN_HOSTS_FILE=

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=apboa_next
MYSQL_USER=root
MYSQL_PASSWORD=CHANGEME_LOCAL_MYSQL_PASSWORD
MYSQL_SSL_MODE=DISABLED
MYSQL_SSL_CA=
